{
  "name": "campaign-forge",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky install",
    "type-check": "pnpm --filter @packages/types run type-check && pnpm --filter @packages/utils run type-check && pnpm --filter @apps/backend run type-check",
    "test": "pnpm build:types && TZ=Europe/Brussels jest -c jest.config.js",
    "build:types": "pnpm --filter @packages/types build",
    "build:packages": "pnpm build:types",
    "build:backend": "pnpm --filter @apps/backend build",
    "dev:backend": "pnpm build:types && pnpm --filter @apps/backend start:dev",
    "dev:landing": "pnpm --filter landing dev",
    "dev:frontend": "pnpm --filter @apps/frontend dev",
    "build:landing": "pnpm --filter landing build",
    "build:frontend": "pnpm --filter @apps/frontend build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean-install": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm install",
    "audit:backend": "node scripts/audit-backend.cjs",
    "test:security": "node --test scripts/__tests__/audit-backend.test.cjs",
    "test:backend-http": "node --test scripts/__tests__/backend-http.test.cjs"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "supportedArchitectures": {
      "libc": [
        "glibc",
        "musl"
      ]
    },
    "overrides": {
      "canvas": "npm:@napi-rs/canvas@0.1.71",
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1",
      "@types/node": "20.11.5",
      "sharp": "0.33.5",
      "zod": "4.6.7",
      "@expo/config-plugins": "~9.0.0",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "react-test-renderer": "18.3.1",
      "glob@10": "^10.5.0",
      "glob@11": "^11.1.0",
      "minimatch@9": "^9.0.7",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "lodash": "^4.18.0",
      "fflate": "^0.8.3",
      "form-data@4": "^4.0.6",
      "ws@8": "^8.21.0",
      "uuid@9": "^11.1.1",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "fast-xml-parser@5": "^5.7.0",
      "proxy-addr@2": "^2.0.8",
      "qs@6": "^6.16.1"
    }
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/jest": "^29.5.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.1.0"
  },
  "version": "1.0.0"
}
