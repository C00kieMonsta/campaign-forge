PORT=3001
AWS_REGION=eu-north-1

# AWS credentials (DynamoDB + SES access)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB table names
CONTACTS_TABLE=cf-contacts-production
CAMPAIGNS_TABLE=cf-campaigns-production
GROUPS_TABLE=cf-groups-production

# S3 bucket for uploads (images + attachments)
S3_BUCKET=campaign-forge-uploads-prod

# Uncomment for DynamoDB Local during development:
# DDB_ENDPOINT=http://localhost:8000

# SES email sender (must be verified in AWS SES)
SES_FROM_EMAIL=
SES_REGION=eu-north-1

# Unsubscribe token signing secret (min 32 chars, generate with: openssl rand -base64 32)
UNSUBSCRIBE_SECRET=

# Public URL of the API (used for unsubscribe links in emails)
PUBLIC_BASE_URL=https://api.moniquepirson.be/api

# Lex PostgreSQL. TLS verifies certificates and hostnames with the bundled RDS eu-north-1 CAs.
# DATABASE_URL=postgresql://user:password@database.example:5432/lex
# DATABASE_SSL_CA_FILE=/absolute/path/to/custom-ca.pem
# Local PostgreSQL only. Production cannot disable TLS.
# DATABASE_SSL=false
