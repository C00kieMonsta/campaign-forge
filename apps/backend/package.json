{
  "name": "@apps/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "type-check": "tsc --noEmit",
    "test": "TZ=Europe/Brussels jest -c ../../jest.config.js --selectProjects backend",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --",
    "lint": "eslint src --ext .ts",
    "eval": "nest build && node dist/lex/eval/run-eval.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "3.995.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "3.995.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@packages/types": "workspace:*",
    "archiver": "^7.0.1",
    "bcryptjs": "3.0.3",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.0",
    "dotenv": "^16.4.0",
    "jsonwebtoken": "9.0.3",
    "mammoth": "^1.8.0",
    "node-pg-migrate": "^7.9.1",
    "nodemailer": "8.0.1",
    "openai": "^4.77.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "unpdf": "^0.12.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.0",
    "@types/archiver": "6.0.3",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "20.11.5",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "^8.11.10",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.0"
  }
}
